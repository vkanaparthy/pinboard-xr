# Copy to .env and adjust:  cp .env.example .env

# ---- Browser-side (shipped to the page) ---------------------------------
# Which local backend is active on first load: ollama | muse
VITE_AI_PROVIDER=ollama
# Model names (both can be changed later in the 2D overlay)
VITE_OLLAMA_MODEL=llama3.2
VITE_MUSE_MODEL=muse

# ---- Server-side only (used by the Vite proxy, never sent to the browser) ----
# OpenAI-compatible base URLs, including the /v1 path
OLLAMA_URL=http://127.0.0.1:11434/v1
# MUSE / LM Studio / llama.cpp / vLLM, etc. Common ports: 8000, 1234, 8080
MUSE_URL=http://127.0.0.1:8000/v1
